{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChartRecorder Economic Events Normalized Daily JSON",
  "type": "object",
  "required": [
    "schema_version",
    "report_date_jst",
    "generated_at_utc",
    "master_policy_version",
    "acquisition",
    "events",
    "display_groups",
    "review_record_ids",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_date_jst": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "master_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "acquisition": {
      "type": "object",
      "required": [
        "provider",
        "fetch_status",
        "coverage_status",
        "license_status",
        "range_start_utc",
        "range_end_utc_exclusive"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "fetch_status": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "MOCK"
          ]
        },
        "coverage_status": {
          "enum": [
            "CONFIRMED",
            "UNVERIFIED",
            "INCOMPLETE",
            "MOCK"
          ]
        },
        "license_status": {
          "enum": [
            "APPROVED",
            "PENDING",
            "MOCK"
          ]
        },
        "range_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "range_end_utc_exclusive": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "display_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "review_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "counts": {
      "type": "object",
      "required": [
        "fetched",
        "matched_S",
        "matched_A",
        "review",
        "display_groups"
      ],
      "properties": {
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "matched_S": {
          "type": "integer",
          "minimum": 0
        },
        "matched_A": {
          "type": "integer",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "minimum": 0
        },
        "display_groups": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "record_id",
        "source_record_id",
        "country",
        "currency",
        "title_raw",
        "date_utc",
        "date_jst",
        "time_precision",
        "provider_importance",
        "master_indicator_id",
        "rank",
        "match_status",
        "release_status",
        "values",
        "first_party"
      ],
      "properties": {
        "record_id": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "currency": {
          "enum": [
            "USD",
            "JPY",
            "EUR",
            "GBP",
            "AUD",
            "NZD",
            "CAD"
          ]
        },
        "title_raw": {
          "type": "string"
        },
        "date_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "date_jst": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "time_precision": {
          "enum": [
            "EXACT",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "provider_importance": {
          "type": "object"
        },
        "master_indicator_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "enum": [
            "S",
            "A",
            null
          ]
        },
        "match_status": {
          "enum": [
            "MATCHED",
            "REVIEW",
            "EXPLICIT_EXCLUDE"
          ]
        },
        "release_status": {
          "enum": [
            "SCHEDULED",
            "RELEASED_VERIFIED",
            "UNVERIFIED_EARLY_ACTUAL",
            "TIME_UNKNOWN"
          ]
        },
        "values": {
          "type": "object",
          "required": [
            "previous",
            "forecast",
            "actual",
            "revised_previous",
            "unit",
            "scale"
          ]
        },
        "first_party": {
          "type": "object",
          "required": [
            "organization",
            "url",
            "verified"
          ]
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "group_key",
        "currency",
        "master_indicator_id",
        "rank",
        "display_name_ja",
        "date_jst",
        "record_ids"
      ],
      "properties": {
        "group_key": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "master_indicator_id": {
          "type": "string"
        },
        "rank": {
          "enum": [
            "S",
            "A"
          ]
        },
        "display_name_ja": {
          "type": "string"
        },
        "date_jst": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
